{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product for sale in the store.",
      "type": "object",
      "properties": {
        "sku": { "$ref": "#/entities/String" },
        "name": { "$ref": "#/entities/String" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "$ref": "#/entities/String" },
        "status": { "enum": ["published", "draft"] },
        "image": { "$ref": "#/entities/String" },
        "description": { "$ref": "#/entities/String" },
        "sizes": {
          "type": "array",
          "items": { "$ref": "#/entities/String" }
        }
      },
      "required": ["name", "price", "image", "description", "sizes"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array"
        },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "status": { "enum": ["pending", "processing", "completed", "cancelled"] }
      },
      "required": ["items", "customer", "date", "total", "status"]
    },
    "String": {
      "type": "string"
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Contains products available in the store."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Contains customer store orders."
    }
  }
}
